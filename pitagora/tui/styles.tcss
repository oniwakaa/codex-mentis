/* Pitagora Textual TUI Stylesheet */

Screen {
    layout: vertical;
    background: $surface;
    color: $text;
}

#workspace {
    height: 1fr;
    layout: horizontal;
}

#sidebar {
    width: 28;
    background: $surface-darken-1;
    border-right: heavy $primary;
    padding: 1;
}

#main-panel {
    width: 1fr;
    height: 1fr;
    background: $surface;
    padding: 1;
    layout: vertical;
}

#inspector {
    width: 32;
    background: $surface-darken-1;
    border-left: heavy $primary;
    padding: 1;
}

Input#chat-input {
    margin-top: 1;
    height: 3;
    border: solid $accent;
}

AgentStatusWidget {
    height: 5;
    border: solid $accent;
    content-align: center middle;
}

TokenMeterWidget {
    height: 3;
    margin: 1 0;
}

ConceptTreeWidget {
    height: 1fr;
    border: round $primary;
}

JourneyBarWidget {
    height: 3;
    margin: 1 0;
}

MessageLogWidget {
    height: 1fr;
    border: solid $secondary;
    overflow-y: scroll;
}

CommandPaletteWidget {
    height: 10;
    border: double $accent;
    display: none;
}

.modal-open CommandPaletteWidget {
    display: block;
}

.hidden {
    display: none;
}
