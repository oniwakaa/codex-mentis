/* Pitagora Textual TUI Modern Theme (Catppuccin Mocha / Tokyo Night) */

Screen {
    layout: vertical;
    background: #181825;
    color: #cdd6f4;
}

#workspace {
    height: 1fr;
    layout: horizontal;
    background: #181825;
}

#sidebar {
    width: 30;
    background: #11111b;
    border-right: round #45475a;
    padding: 0 1;
    layout: vertical;
}

#main-panel {
    width: 1fr;
    height: 1fr;
    background: #181825;
    padding: 0 1;
    layout: vertical;
}

#inspector {
    width: 34;
    background: #11111b;
    border-left: round #45475a;
    padding: 0 1;
    layout: vertical;
}

Input#chat-input {
    margin: 1 0 0 0;
    height: 3;
    background: #1e1e2e;
    color: #cdd6f4;
    border: round #89b4fa;
}

Input#chat-input:focus {
    border: round #cba6f7;
    background: #1e1e2e;
}

AgentStatusWidget {
    height: auto;
    margin: 1 0 0 0;
}

TokenMeterWidget {
    height: auto;
    margin: 1 0 0 0;
}

MemoryInspectorWidget {
    height: 1fr;
    margin: 1 0 1 0;
}

ConceptTreeWidget {
    height: 1fr;
    margin: 0 0 1 0;
}

JourneyBarWidget {
    height: auto;
    margin: 1 0 1 0;
}

MessageLogWidget {
    height: 1fr;
    background: #1e1e2e;
    border: round #313244;
    overflow-y: auto;
    padding: 1;
}


CommandPaletteWidget {
    height: auto;
    max-height: 12;
    margin: 0 0 1 0;
    display: none;
}

.modal-open CommandPaletteWidget {
    display: block;
}

.hidden {
    display: none;
}

#plot-workspace {
    height: 1fr;
    background: #181825;
    padding: 1 2;
    layout: vertical;
}

InteractivePlotWidget {
    height: 1fr;
    background: #1e1e2e;
    border: round #89b4fa;
    padding: 0 1;
    layout: vertical;
}

#plot-header {
    height: 1;
    margin-bottom: 0;
}

#plot-canvas {
    height: 1fr;
    background: #181825;
}

#plot-toolbar {
    height: 3;
    align: center middle;
    background: #11111b;
    margin-top: 0;
    padding: 0 1;
}

#plot-toolbar Button {
    margin: 0 1;
    min-width: 10;
    height: 1;
    border: none;
    background: #313244;
    color: #cdd6f4;
}

#plot-toolbar Button:hover {
    background: #89b4fa;
    color: #11111b;
}

#plot-toolbar Button.-active {
    background: #a6e3a1;
    color: #11111b;
}

